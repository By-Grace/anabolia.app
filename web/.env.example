NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Pagamento: "teste" (padrão) ou "onprofit" quando a conta e o produto existirem.
PAYMENT_PROVIDER=
# Segredo do webhook de pagamento (HMAC). Só servidor.
PAYMENT_WEBHOOK_SECRET=
# "on" liga o bloqueio por assinatura. Vazio ou outro valor: o app fica aberto.
PAYWALL=
# Endereço público do site, usado no link do e-mail (ex.: https://anabolia.app).
NEXT_PUBLIC_SITE_URL=
# "on" mostra o botão. Configure o provedor no Supabase antes (Apple exige conta de desenvolvedor).
NEXT_PUBLIC_LOGIN_GOOGLE=
NEXT_PUBLIC_LOGIN_APPLE=
