{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "direcoes",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "design/direcoes"
      ],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd web && NEXT_DIST_DIR=.next-build npx next start -p 3100"
      ],
      "port": 3100
    }
  ]
}